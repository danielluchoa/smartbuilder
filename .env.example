# ============================================================================
# SmartBuilder — environment configuration
# Copy to ".env" and fill in real values:   cp .env.example .env
# NEVER commit the real .env (passwords). docker compose reads it
# automatically for ${...} substitution in docker-compose.yml.
# ============================================================================

# --- MySQL (the "db" service) ------------------------------------------------
# Root password for the MySQL server itself (used by admin/backup only).
# Generate a strong one:  openssl rand -hex 24
MYSQL_ROOT_PASSWORD=change-me-root-password

# Application database name and the app's own MySQL user. The app connects
# with this user ONLY (never root). Schema (db/schema.sql) is loaded into
# MYSQL_DATABASE automatically on the first boot of an empty data volume.
MYSQL_DATABASE=smartbuilder
MYSQL_USER=smartbuilder
MYSQL_PASSWORD=change-me-app-password

# --- App (the "app" service) ---------------------------------------------------
# Host port the app is published on. It binds to 127.0.0.1 ONLY, so the app
# is never directly public: the reverse proxy (Caddy/nginx, see DEPLOY.md)
# is the single entry point and adds TLS + the password gate.
APP_PORT=3000

# --- Site ----------------------------------------------------------------------
# Public domain the app is served on (used in DEPLOY.md proxy examples).
DOMAIN=smartbuilderusa.com

# --- Optional ------------------------------------------------------------------
# Password-gate credentials for the reverse proxy (basic auth) are NOT read
# from this file — they live in the proxy config (Caddyfile htpasswd hash),
# see DEPLOY.md step 6. Nothing else needs configuring: the app reads
# DATABASE_URL, which docker-compose.yml assembles from the values above.
